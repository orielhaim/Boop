---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Boop | Private messages and calls" description="Send end-to-end encrypted messages over Nostr and make direct voice calls with optional video.">
  <section class="hero">
    <img class="app-icon" src="/boop.png" alt="" width="88" height="88" />
    <h1>Private messages.<br />Direct calls.</h1>
    <p>Boop is a messaging and calling app built on Nostr. Share your public address to start a conversation.</p>
    <a class="button" href="https://github.com/orielhaim/Boop">View on GitHub <span aria-hidden="true">↗</span></a>
  </section>
  <section class="features" aria-label="Boop features">
    <div><h2>Encrypted chats</h2><p>Send end-to-end encrypted messages, including texts that open at a time you choose.</p></div>
    <div><h2>Decentralized delivery</h2><p>Your device creates your Nostr identity. Independent relays deliver encrypted messages.</p></div>
    <div><h2>Peer-to-peer calls</h2><p>Talk directly over WebRTC and share your camera when you choose.</p></div>
  </section>
</Layout>
