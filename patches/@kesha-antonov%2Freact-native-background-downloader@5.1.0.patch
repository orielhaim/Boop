@@ -0,0 +1,196 @@
+package com.kesha_antonov
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import okhttp3.ConnectionPool
+import okhttp3.CookieJar
+import okhttp3.Dns
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody
+import okio.BufferedSink
+import java.io.File
+import java.io.IOException
+import java.net.Inet4Address
+import java.net.Inet6Address
+import java.net.InetAddress
+import java.net.Proxy
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.TimeUnit
+
+internal const val BOOP_UPLOAD_PREFIX = "boop-put-"
+
+class BoopUploadService : Service() {
+    private class Lease(val start: () -> Unit, val interrupt: () -> Unit)
+    private val active = mutableMapOf<String, Lease>()
+
+    companion object {
+        private const val CHANNEL = "boop_media_upload"
+        private const val NOTIFICATION = 19409233
+        private val pending = ConcurrentHashMap<String, Lease>()
+        private val main = Handler(Looper.getMainLooper())
+        private var running: BoopUploadService? = null
+
+        internal fun start(context: Context, id: String, start: () -> Unit, interrupt: () -> Unit) {
+            check(pending.putIfAbsent(id, Lease(start, interrupt)) == null)
+            try {
+                context.startForegroundService(Intent(context, BoopUploadService::class.java).putExtra("id", id))
+            } catch (error: Exception) {
+                pending.remove(id)
+                throw error
+            }
+        }
+
+        internal fun finish(id: String) {
+            pending.remove(id)
+            main.post {
+                val service = running ?: return@post
+                service.active.remove(id)
+                if (service.active.isEmpty() && pending.isEmpty()) service.stopSelf()
+            }
+        }
+    }
+
+    override fun onBind(intent: Intent): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        running = this
+        val label = applicationInfo.loadLabel(packageManager)
+        val notifications = getSystemService(NotificationManager::class.java)
+        notifications.createNotificationChannel(NotificationChannel(CHANNEL, label, NotificationManager.IMPORTANCE_LOW))
+        val notification = Notification.Builder(this, CHANNEL)
+            .setSmallIcon(android.R.drawable.stat_sys_upload)
+            .setContentTitle(label)
+            .setVisibility(Notification.VISIBILITY_PRIVATE)
+            .setProgress(0, 0, true)
+            .setOngoing(true)
+            .build()
+        val id = intent?.getStringExtra("id")
+        val lease = id?.let { pending.remove(it) }
+        try {
+            startForeground(NOTIFICATION, notification)
+        } catch (_: RuntimeException) {
+            lease?.interrupt?.invoke()
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        if (id != null && lease != null) {
+            active[id] = lease
+            lease.start()
+        } else if (active.isEmpty() && pending.isEmpty()) {
+            stopSelf(startId)
+        }
+        return START_NOT_STICKY
+    }
+
+    override fun onTimeout(startId: Int, fgsType: Int) {
+        stopSelf()
+    }
+
+    override fun onDestroy() {
+        if (running === this) running = null
+        for (lease in active.values) lease.interrupt()
+        active.clear()
+        super.onDestroy()
+    }
+}
+
+private fun isPublic(address: InetAddress): Boolean {
+    val (a, b, c, d) = address.address.map { it.toInt() and 255 }
+    if (address is Inet6Address) {
+        return a in 0x20..0x3f && !(a == 0x20 && b == 0x02) &&
+            !(a == 0x20 && b == 0x01 && (c < 2 || (c == 0x0d && d == 0xb8))) &&
+            !(a == 0x3f && b == 0xff)
+    }
+    return address is Inet4Address && a in 1..223 && a != 10 && a != 127 &&
+        !(a == 100 && b in 64..127) && !(a == 169 && b == 254) &&
+        !(a == 172 && b in 16..31) &&
+        !(a == 192 && (b == 168 || (b == 0 && c in setOf(0, 2)) || (b == 88 && c == 99))) &&
+        !(a == 198 && (b in 18..19 || (b == 51 && c == 100))) &&
+        !(a == 203 && b == 0 && c == 113)
+}
+
+private val client = OkHttpClient.Builder()
+    .dns(object : Dns {
+        override fun lookup(hostname: String): List<InetAddress> {
+            val addresses = Dns.SYSTEM.lookup(hostname)
+            if (addresses.isEmpty() || addresses.any { !isPublic(it) }) throw IOException("Media destination rejected")
+            return addresses
+        }
+    })
+    .proxy(Proxy.NO_PROXY)
+    .cookieJar(CookieJar.NO_COOKIES)
+    .connectionPool(ConnectionPool(0, 1, TimeUnit.SECONDS))
+    .followRedirects(false)
+    .followSslRedirects(false)
+    .retryOnConnectionFailure(false)
+    .callTimeout(5, TimeUnit.MINUTES)
+    .build()
+
+internal fun uploadBoopAttachment(
+    context: Context,
+    state: Uploader.UploadState,
+    listener: Uploader.UploadListener,
+    http: OkHttpClient = client
+) {
+    val config = state.config
+    val url = config.url.toHttpUrl()
+    val source = File(config.source).canonicalFile
+    val root = File(context.filesDir, "attachment-blobs").canonicalFile
+    val size = source.length()
+    val headers = config.headers ?: throw IOException("Media authorization missing")
+    val allowedHost = Regex("""(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{1,62}""")
+    require(allowedHost.matches(url.host) && url.isHttps && url.port == 443 && url.encodedPath == "/upload" && url.query == null &&
+        url.username.isEmpty() && url.password.isEmpty() && url.fragment == null &&
+        config.method == "PUT" && config.fieldName == null && config.parameters == null && config.partUrls == null &&
+        source.path.startsWith(root.path + File.separator) && size in 17..(32L * 1024 * 1024) &&
+        source.name == "sent-${headers["X-SHA-256"]}.bin" && source.name.matches(Regex("sent-[a-f0-9]{64}\\.bin")) &&
+        headers["Content-Length"] == size.toString())
+    val expiry = org.json.JSONObject(config.metadata).getLong("expiresAt")
+    if (System.currentTimeMillis() >= expiry) {
+        listener.onError(state.id, "Media authorization expired", 401)
+        return
+    }
+    val body = object : RequestBody() {
+        override fun contentType() = "application/octet-stream".toMediaType()
+        override fun contentLength() = size
+        override fun isOneShot() = true
+        override fun writeTo(sink: BufferedSink) {
+            val bytes = ByteArray(64 * 1024)
+            source.inputStream().use { input ->
+                while (state.bytesUploaded.get() < size) {
+                    if (state.isCancelled.get()) throw IOException("Media cancelled")
+                    val count = input.read(bytes, 0, minOf(bytes.size.toLong(), size - state.bytesUploaded.get()).toInt())
+                    if (count <= 0) throw IOException("Media source ended")
+                    sink.write(bytes, 0, count)
+                    listener.onProgress(state.id, state.bytesUploaded.addAndGet(count.toLong()), size)
+                }
+            }
+        }
+    }
+    val request = Request.Builder().url(url).put(body).header("Accept-Encoding", "identity")
+    for (name in listOf("Authorization", "X-SHA-256")) request.header(name, headers.getValue(name))
+    val call = http.newCall(request.build())
+    state.call = call
+    if (state.isCancelled.get()) call.cancel()
+    listener.onBegin(state.id, size)
+    call.execute().use { response ->
+        if (state.isCancelled.get()) return
+        if (response.code != 200 && response.code != 201) {
+            listener.onError(state.id, "Media server rejected upload", response.code)
+            return
+        }
+        val data = response.body?.source() ?: throw IOException("Media response missing")
+        if (data.request(8193)) throw IOException("Media response too large")
+        listener.onComplete(state.id, response.code, data.readUtf8(), emptyMap(), null, state.bytesUploaded.get(), size)
+    }
+}
