index 0000000000000000000000000000000000000000..dbc0b2140a57dc2e449ee47e5540367035642ac7
--- /dev/null
+++ b/android/src/test/java/com/kesha_antonov/BoopUploadTest.kt
@@ -0,0 +1,93 @@
+package com.kesha_antonov
+
+import android.content.Context
+import androidx.test.core.app.ApplicationProvider
+import okhttp3.OkHttpClient
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.io.File
+import java.security.MessageDigest
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class BoopUploadTest {
+    @Test
+    fun rawPutSendsTheCiphertextAndRejectsAnExpiredOrInvalidStart() {
+        val context = ApplicationProvider.getApplicationContext<Context>()
+        val bytes = ByteArray(64 * 1024 + 17) { (it % 251).toByte() }
+        val hash = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+        val assets = File(context.filesDir, "attachment-blobs").apply { mkdirs() }
+        val file = File(assets, "sent-$hash.bin").apply { writeBytes(bytes) }
+        val authorization = "Nostr test-token"
+        val config = RNBGDUploadTaskConfig(
+            id = "boop-put-vector",
+            url = "https://blossom.example.com/upload",
+            source = file.path,
+            metadata = """{"expiresAt":${System.currentTimeMillis() + 120_000}}""",
+            method = "PUT",
+            headers = mapOf(
+                "Authorization" to authorization,
+                "X-SHA-256" to hash,
+                "Content-Length" to bytes.size.toString()
+            )
+        )
+        val errors = mutableListOf<Int>()
+        val received = mutableListOf<Pair<Int, String>>()
+        val sent = mutableListOf<Long>()
+        val listener = object : Uploader.UploadListener {
+            override fun onBegin(id: String, expectedBytes: Long) {
+                assertEquals(bytes.size.toLong(), expectedBytes)
+            }
+
+            override fun onProgress(id: String, bytesUploaded: Long, bytesTotal: Long) {
+                sent.add(bytesUploaded)
+            }
+
+            override fun onPartComplete(id: String, part: UploadPartResult) = error("Unexpected multipart upload")
+
+            override fun onComplete(
+                id: String, responseCode: Int, responseBody: String,
+                responseHeaders: Map<String, String>, parts: List<UploadPartResult>?,
+                bytesUploaded: Long, bytesTotal: Long
+            ) {
+                received.add(responseCode to responseBody)
+            }
+
+            override fun onError(id: String, error: String, errorCode: Int) {
+                errors.add(errorCode)
+            }
+        }
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setResponseCode(201).setBody("""{"size":${bytes.size}}"""))
+            server.start()
+            val client = OkHttpClient.Builder().addInterceptor { chain ->
+                // Keep the validated URL in the application code and route only this test to loopback.
+                chain.proceed(chain.request().newBuilder().url(server.url("/upload")).build())
+            }.build()
+            fun send(config: RNBGDUploadTaskConfig) {
+                uploadBoopAttachment(context, Uploader.UploadState(config.id, config), listener, client)
+            }
+            send(config)
+            val request = server.takeRequest()
+            assertEquals("PUT", request.method)
+            assertEquals("/upload", request.path)
+            assertEquals("application/octet-stream", request.getHeader("Content-Type"))
+            assertEquals(authorization, request.getHeader("Authorization"))
+            assertEquals(hash, request.getHeader("X-SHA-256"))
+            assertArrayEquals(bytes, request.body.readByteArray())
+            assertEquals(listOf(65536L, bytes.size.toLong()), sent)
+            assertEquals(listOf(201 to """{"size":${bytes.size}}"""), received)
+            send(config.copy(metadata = """{"expiresAt":0}"""))
+            assertEquals(listOf(401), errors)
+            assertThrows(IllegalArgumentException::class.java) { send(config.copy(url = "https://127.0.0.1/upload")) }
+            assertEquals(1, server.requestCount)
+        }
+    }
+}
