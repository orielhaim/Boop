+import React, { useLayoutEffect, useState } from 'react';
+import { useIsMessageViewable, useMediaPlaybackController } from '../components/mediaPlayback';
+import { RoundNotePlayer } from './RoundNotePlayer';
+import { expoVideo } from './videoPlayers';
+
+/** Keep the resolved source and native player together for the lifetime of the row. */
+export function ManagedRoundNote({ acquire, fallback, ...props }) {
+  const controller = useMediaPlaybackController();
+  const visible = useIsMessageViewable(props.message.rowKey ?? props.messageId);
+  const shouldPrepare = !controller || visible === true;
+  const [loaded, setLoaded] = useState();
+  useLayoutEffect(() => {
+    if (!shouldPrepare) return;
+    const abort = new AbortController();
+    let handle;
+    let deadline;
+    let closeTask;
+    const player = expoVideo.createVideoPlayer(null);
+    player.muted = true;
+    player.audioMixingMode = 'doNotMix';
+    player.keepScreenOnWhilePlaying = false;
+
+    const invalidate = () => {
+      if (closeTask) return closeTask;
+      abort.abort();
+      player.pause();
+      closeTask = (async () => {
+        try {
+          await loading.catch(() => undefined);
+          await player.replaceAsync(null);
+        } finally {
+          try {
+            deadline?.remove();
+            player.release();
+          } finally {
+            await handle?.release();
+          }
+        }
+      })().catch(() => undefined);
+      return closeTask;
+    };
+    const revoke = () => {
+      setLoaded(current => current?.player === player ? undefined : current);
+      return invalidate();
+    };
+    const loading = Promise.resolve().then(async () => {
+      if (abort.signal.aborted) return;
+      handle = await acquire({ signal: abort.signal, invalidate: revoke });
+      if (abort.signal.aborted) return;
+      if (handle.expiresAt != null) {
+        if (handle.expiresAt <= Date.now() || typeof player.setPlaybackDeadline !== 'function') {
+          throw new Error('Round note deadline unavailable');
+        }
+        deadline = player.addListener('playbackDeadlineExpired', () => {
+          void revoke();
+        });
+        player.setPlaybackDeadline(handle.expiresAt);
+      }
+      await player.replaceAsync({ uri: handle.uri, useCaching: false });
+      if (!abort.signal.aborted) setLoaded({ acquire, player, uri: handle.uri, signal: abort.signal });
+    });
+    void loading.catch(revoke);
+    return () => { void invalidate(); };
+  }, [acquire, shouldPrepare]);
+
+  if (!shouldPrepare || !loaded || loaded.acquire !== acquire || loaded.signal.aborted) return fallback;
+  return <RoundNotePlayer {...props} uri={loaded.uri} ownedPlayer={loaded.player} claim={props.claim && (stop => !loaded.signal.aborted && props.claim(stop))} />;
+}
