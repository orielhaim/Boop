{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/src/components/glassyui",
      "!**/src/db/migrations",
      "!**/android",
      "!**/ios",
      "!**/.expo",
      "!**/dist",
      "!**/expo-env.d.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noReactNativeRawText": {
          "options": {
            "skip": [
              "Action",
              "Ink",
              "Section",
              "Label",
              "NativeTabs.Trigger.Label",
              "GlassSegmentedControlItem",
              "GlassSheetTitle",
              "GlassMenuItem"
            ]
          },
          "level": "error"
        }
      }
    }
  }
}
