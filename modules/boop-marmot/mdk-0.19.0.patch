+    /// Sign an unsigned Nostr event with the active account's signer.
+    pub async fn sign_nostr_event(
+        &self,
+        account_ref: String,
+        unsigned_json: String,
+    ) -> Result<String, MarmotKitError> {
+        use nostr::prelude::UnsignedEvent;
+        let invalid = || MarmotKitError::InvalidIdentity {
+            details: "invalid unsigned Nostr event".into(),
+        };
+        let event = serde_json::from_str::<UnsignedEvent>(&unsigned_json).map_err(|_| invalid())?;
+        event.verify_id().map_err(|_| invalid())?;
+        let signer = self.runtime.account_nostr_signer(&account_ref)?;
+        if event.pubkey.to_hex() != account_ref {
+            return Err(invalid());
+        }
+        signer
+            .sign_event(event)
+            .await
+            .map(|event| event.sig.to_string())
+            .map_err(|_| invalid())
+    }
+
+    /// Encrypt or decrypt a Nostr payload without exposing the credential.
+    pub async fn nostr_cipher(
+        &self,
+        account_ref: String,
+        peer: String,
+        content: String,
+        nip44: bool,
+        encrypt: bool,
+    ) -> Result<String, MarmotKitError> {
+        use nostr::prelude::PublicKey;
+        let invalid = || MarmotKitError::InvalidIdentity {
+            details: "invalid Nostr cipher input".into(),
+        };
+        let peer = PublicKey::from_hex(&peer).map_err(|_| invalid())?;
+        let signer = self.runtime.account_nostr_signer(&account_ref)?;
+        match (nip44, encrypt) {
+            (true, true) => signer.nip44_encrypt(&peer, &content).await,
+            (true, false) => signer.nip44_decrypt(&peer, &content).await,
+            (false, true) => signer.nip04_encrypt(&peer, &content).await,
+            (false, false) => signer.nip04_decrypt(&peer, &content).await,
+        }
+        .map_err(|_| invalid())
+    }
