+fn boop_control_events_never_occupy_timeline_positions() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    let app = store.app_storage();
+    let group = "11".repeat(32);
+    app.record_app_event(&chat("before", "alice", 10, "before"))
+        .unwrap();
+    for (id, kind) in [("call", 24884), ("support", 24885)] {
+        let mut control = chat(id, "alice", 20, "raw control");
+        control.kind = kind;
+        app.record_app_event(&control).unwrap();
+    }
+    app.record_app_event(&chat("after", "alice", 30, "after"))
+        .unwrap();
+
+    let verify = || {
+        for hidden in ["call", "support"] {
+            assert!(app.timeline_message(&group, hidden).unwrap().is_none());
