+#[test]
+fn boop_control_events_never_occupy_timeline_positions() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    let app = store.app_storage();
+    let group = "11".repeat(32);
+    app.record_app_event(&chat("before", "alice", 10, "before"))
+        .unwrap();
+    for (id, kind) in [("call", 24884), ("support", 24885)] {
+        let mut control = chat(id, "alice", 20, "raw control");
+        control.kind = kind;
+        app.record_app_event(&control).unwrap();
+    }
+    app.record_app_event(&chat("after", "alice", 30, "after"))
+        .unwrap();
+
+    let verify = || {
+        for hidden in ["call", "support"] {
+            assert!(app.timeline_message(&group, hidden).unwrap().is_none());
+            assert!(matches!(
+                timeline_order_cursor_tx(&store.lock().unwrap(), &group, hidden),
+                Err(StorageError::TimelineCursorExpired)
+            ));
+        }
+        let page = app
+            .message_timeline(TimelineMessageQuery {
+                group_id_hex: Some(group.clone()),
+                pagination: TimelinePagination {
+                    before: Some(30),
+                    before_message_id: Some("after".into()),
+                    limit: Some(1),
+                    ..Default::default()
+                },
+                ..Default::default()
+            })
+            .unwrap();
+        assert_eq!(ids(&page), ["before"]);
+        assert!(!page.has_more_before);
+    };
+    verify();
+    app.rebuild_message_timeline_for_group(&group).unwrap();
+    verify();
+}
