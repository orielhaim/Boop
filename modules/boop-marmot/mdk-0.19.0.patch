+enum ProfilePublication {
+    Replace(UserProfileMetadata),
+    Edit(std::collections::HashMap<String, String>),
+}
+
+fn apply_profile_edits(
+    mut fields: serde_json::Map<String, serde_json::Value>,
+    edits: std::collections::HashMap<String, String>,
+) -> Result<serde_json::Value, AppError> {
+    if let Some(value) = edits.get("display_name") {
+        let previous = fields.remove("displayName");
+        let display_name = fields.get("display_name").or(previous.as_ref());
+        if !edits.contains_key("name") && (!fields.contains_key("name") || fields.get("name") == display_name) {
+            if value.is_empty() {
+                fields.remove("name");
+            } else {
+                fields.insert("name".into(), serde_json::Value::String(value.clone()));
+            }
+        }
+    }
+    for (field, value) in edits {
+        if !matches!(field.as_str(), "display_name" | "name" | "about" | "picture" | "banner" | "nip05" | "lud16" | "website") {
+            return Err(AppError::RelayDirectory("unsupported profile edit field".into()));
+        }
+        if value.is_empty() {
+            fields.remove(&field);
+        } else {
+            fields.insert(field, serde_json::Value::String(value));
+        }
+    }
+    Ok(serde_json::Value::Object(fields))
+}
