+/// A decoded identity awaiting the host's explicit import confirmation.
+#[derive(uniffi::Object)]
+pub struct PreparedIdentityImport {
+    public_key: String,
+    nsec: Zeroizing<String>,
+}
+
+#[uniffi::export]
+impl PreparedIdentityImport {
+    pub fn public_key(&self) -> String {
+        self.public_key.clone()
+    }
+}
+
+fn decode_identity_backup(
+    input: &str,
+    password: &str,
+) -> Result<PreparedIdentityImport, MarmotKitError> {
+    let invalid = || MarmotKitError::InvalidIdentity {
+        details: "invalid identity backup".into(),
+    };
+    let input = input.trim();
+    let input = input
+        .get(..6)
+        .filter(|prefix| prefix.eq_ignore_ascii_case("nostr:"))
+        .map_or(input, |_| &input[6..]);
+    if input.len() > 162 || password.len() > 2048 {
+        return Err(invalid());
+    }
+    let keys = if input.starts_with("ncryptsec1") {
+        let encrypted = EncryptedSecretKey::from_bech32(input).map_err(|_| invalid())?;
+        if !(1..=EncryptedSecretKey::MAX_LOG_N).contains(&encrypted.log_n()) {
+            return Err(MarmotKitError::InvalidIdentity {
+                details: "identity backup exceeds the supported scrypt cost".into(),
+            });
+        }
+        Keys::new(encrypted.decrypt(password).map_err(|_| invalid())?)
+    } else {
+        Keys::parse(input).map_err(|_| invalid())?
+    };
+    Ok(PreparedIdentityImport {
+        public_key: keys.public_key().to_hex(),
+        nsec: Zeroizing::new(keys.secret_key().to_bech32().map_err(|_| invalid())?),
+    })
+}
 
