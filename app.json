{
  "expo": {
    "name": "Boop",
    "slug": "boop",
    "version": "1.0.1-beta.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["boop", "nostr"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.boop.mobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#414DC3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.orielhaim.boop",
      "permissions": ["android.permission.BLUETOOTH_CONNECT"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "locales": {
      "en": "./src/i18n/locales/native-en.json",
      "he": "./src/i18n/locales/native-he.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "toolsButton": false,
          "showMenuAtLaunch": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 144,
          "backgroundColor": "#EDF3FF",
          "dark": {
            "backgroundColor": "#121828"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock Boop when App Lock is enabled."
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "he"],
          "supportsRTL": true,
          "forcesRTL": false
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "cameraPermission": "Capture and send photos or videos, scan Boop addresses, and share your camera during calls.",
          "microphonePermission": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Record voice and video messages and talk during peer-to-peer calls.",
          "cameraPermission": "Capture and send photos or videos, scan Boop addresses, and share your camera during calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select photos and videos to send in Boop.",
          "cameraPermission": "Capture and send photos or videos, scan Boop addresses, and share your camera during calls.",
          "microphonePermission": "Record voice and video messages and talk during peer-to-peer calls."
        }
      ],
      "expo-font",
      "react-native-quick-crypto",
      "./plugins/with-call-tones.js",
      "./plugins/with-system-calling.js",
      "./plugins/with-optional-portrait.js",
      [
        "@hzblj/expo-translation",
        {
          "ios": {
            "mlkit": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "18.0" },
          "android": {
            "minSdkVersion": 31,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Jitsi WebRTC 155 ships the unused Dav1d JNI shim without its decoder. Require R8 to discard the shim.\n-dontwarn org.webrtc.Dav1dDecoder$Natives\n-checkdiscard class org.webrtc.Dav1dDecoderJni"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your current location when you choose it in a chat.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Save photos and videos you choose to keep.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": ["ios", "android"]
  }
}
