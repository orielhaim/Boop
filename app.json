{
  "expo": {
    "name": "Boop",
    "slug": "boop",
    "version": "1.0.1-beta.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.boop.mobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#414DC3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.orielhaim.boop",
      "permissions": ["android.permission.BLUETOOTH_CONNECT"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "locales": {
      "en": "./src/i18n/locales/native-en.json",
      "he": "./src/i18n/locales/native-he.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "toolsButton": false,
          "showMenuAtLaunch": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 144,
          "backgroundColor": "#EDF3FF",
          "dark": {
            "backgroundColor": "#121828"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock Boop when App Lock is enabled."
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "he"],
          "supportsRTL": true,
          "forcesRTL": false
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "cameraPermission": "Scan Boop addresses and share your camera when you choose during a call.",
          "microphonePermission": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Use the microphone for peer-to-peer audio calls.",
          "cameraPermission": "Scan Boop addresses and share your camera when you choose during a call."
        }
      ],
      "expo-font",
      "react-native-quick-crypto",
      "./plugins/with-call-tones.js",
      "./plugins/with-system-calling.js",
      "./plugins/with-optional-portrait.js",
      [
        "@hzblj/expo-translation",
        {
          "ios": {
            "mlkit": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Jitsi WebRTC 155 ships the unused Dav1d JNI shim without its decoder. Require R8 to discard the shim.\n-dontwarn org.webrtc.Dav1dDecoder$Natives\n-checkdiscard class org.webrtc.Dav1dDecoderJni"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": ["ios", "android"]
  }
}
