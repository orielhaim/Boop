{
  "name": "react-native-liquid-engine",
  "version": "0.1.0",
  "description": "Backdrop, geometry and optical glass rendering for React Native",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./skia": "./src/skia.tsx",
    "./playground": "./examples/playground.tsx"
  },
  "files": [
    "src",
    "android/build.gradle",
    "android/src",
    "examples",
    "tests",
    "expo-module.config.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "expo": ">=58",
    "expo-glass-effect": ">=58",
    "react": ">=19",
    "react-native": ">=0.83",
    "react-native-reanimated": ">=4.5",
    "react-native-skia": ">=3.13",
    "react-native-gesture-handler": ">=3",
    "react-native-worklets": ">=0.8"
  },
  "peerDependenciesMeta": {
